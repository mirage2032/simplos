# Each crate's cargo target directory, and the repository's own, which
# holds the trees built for the disk.
target/

# Written by tools/boot/build.rs on every build, pointing at the kernel ELF
# inside an OUT_DIR whose cargo hash is not stable. Machine-specific by
# construction, so they can never be right for two checkouts at once.
/.gdbinit
/.lldbinit

# Release images, produced by scripts/build-images.sh.
/dist

# The ext4 disk `cargo run` makes and keeps, which is the user's.
/tools/boot/disk.img

.idea/
